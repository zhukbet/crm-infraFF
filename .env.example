# Single source of .env for the whole stack. docker-compose.yml passes these into the
# api/workers containers via env_file, and into the web build via build args (see below).

# --- Telegram (backend: BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, TELEGRAM_WEBHOOK_URL) ---
# Token from BotFather. Also verifies the Telegram Login Widget HMAC signature.
BOT_TOKEN=
# Secret string checked against Telegram's X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=change-me
# Public HTTPS URL Telegram will POST updates to, e.g. https://crm.example.com/api/telegram/webhook
TELEGRAM_WEBHOOK_URL=

# --- Auth (backend: JWT_SECRET, SESSION_COOKIE_NAME) ---
JWT_SECRET=change-me
SESSION_COOKIE_NAME=support_crm_session
THREAD_IDLE_WINDOW_MINUTES=180

# --- CORS (backend: FRONTEND_ORIGIN) ---
# Not strictly needed once everything sits behind the reverse proxy on one origin (below),
# but the backend still reads it for any direct cross-origin dev access.
FRONTEND_ORIGIN=http://localhost

# --- Database / queue (backend: DATABASE_URL, REDIS_URL) ---
# Overridden by docker-compose.yml to point at the postgres/redis service names — only used
# here if you run api/workers outside compose.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/support_crm?schema=public
REDIS_URL=redis://localhost:6379

# --- Frontend build args (frontend: VITE_API_URL, VITE_WS_URL, VITE_TELEGRAM_BOT_USERNAME) ---
# Browser-facing origin(s) — same domain as the reverse proxy in prod, so the browser never
# talks to the api container directly. Adjust when you have a real domain. Also reused as the
# api container's PUBLIC_URL (docker-compose.yml) for uploaded-file URLs Telegram fetches
# directly — see /uploads/* in Caddyfile.
PUBLIC_ORIGIN=http://localhost
PUBLIC_WS_ORIGIN=ws://localhost
# @username of the bot BOT_TOKEN belongs to — same bot, needed by the Telegram Login Widget
# on the frontend's /login page. Baked into the frontend build (Vite vars are compile-time).
TELEGRAM_BOT_USERNAME=

# --- Reverse proxy ---
HTTP_PORT=80
