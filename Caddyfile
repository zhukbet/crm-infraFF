:80 {
	# Section 3.7 of the spec: one domain in prod, no CORS. Everything that isn't /api or /ws
	# goes to the frontend static build; /api and /ws go to the backend api container.
	handle /api/* {
		reverse_proxy api:3000
	}

	handle /ws/* {
		reverse_proxy api:3000
	}

	# Agent-attached media (UploadsController) — served by the api container's static assets,
	# outside the /api prefix (see main.ts). Telegram fetches these URLs directly, so they need
	# to resolve through the same public origin as everything else.
	handle /uploads/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:80
	}
}
